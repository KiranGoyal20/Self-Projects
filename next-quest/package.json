{
  "name": "next-quest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "npm --prefix server run dev",
    "dev:all": "concurrently -n web,api -c brand,green \"npm run dev\" \"npm run dev:server\"",
    "build": "tsc -b && vite build",
